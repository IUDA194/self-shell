* {
    bg:                  rgba(55, 45, 41, 92%);
    bg-alt:              rgba(104, 93, 88, 20%);
    bg-selected:         rgba(104, 93, 88, 72%);
    fg:                  rgba(204, 194, 183, 100%);
    fg-muted:            rgba(116, 105, 97, 100%);
    border:              rgba(104, 93, 88, 55%);
    border-strong:       rgba(159, 125, 82, 100%);
    urgent:              rgba(159, 125, 82, 100%);
    background-color:    transparent;
    text-color:          @fg;
    font:                "Noto Sans 13";
}

window {
    width:               44%;
    location:            north;
    anchor:              north;
    y-offset:            10px;
    padding:             10px;
    background-color:    @bg;
    border:              1px;
    border-color:        @border;
    border-radius:       10px;
}

mainbox {
    spacing:             10px;
    children:            [ "inputbar", "listview" ];
}

inputbar {
    spacing:             10px;
    padding:             4px 8px;
    background-color:    @bg-alt;
    border:              1px;
    border-color:        transparent;
    border-radius:       7px;
    children:            [ "prompt", "entry" ];
}

prompt {
    enabled:             true;
    text-color:          @fg;
    str:                 " ";
}

entry {
    placeholder:         "Search apps or run commands";
    placeholder-color:   @fg-muted;
    text-color:          @fg;
    cursor:              text;
}

listview {
    lines:               7;
    columns:             1;
    fixed-height:        false;
    dynamic:             true;
    cycle:               true;
    scrollbar:           false;
    layout:              vertical;
    spacing:             6px;
}

element {
    padding:             7px 12px;
    spacing:             12px;
    background-color:    @bg-alt;
    border:              1px;
    border-color:        transparent;
    border-radius:       7px;
    cursor:              pointer;
}

element normal.normal {
    background-color:    @bg-alt;
    text-color:          @fg;
}

element selected.normal {
    background-color:    @bg-selected;
    text-color:          @fg;
    border:              1px;
    border-color:        @border-strong;
}

element-icon {
    size:                1.1em;
    vertical-align:      0.5;
    background-color:    transparent;
}

element-text {
    vertical-align:      0.5;
    text-color:          inherit;
    background-color:    transparent;
}
